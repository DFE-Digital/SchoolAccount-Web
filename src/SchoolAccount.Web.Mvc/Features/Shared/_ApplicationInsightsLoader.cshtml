@using System.Text.Json
@inject IConfiguration Configuration
@using SchoolAccount.Application.Abstractions.Messaging
@using SchoolAccount.SharedKernel
@inject IUserContext UserContext

@{
    var connectionString =
        Configuration["APPLICATIONINSIGHTS_CONNECTION_STRING"];
    
    var analyticsUserId = UserContext.Id;

    var organisationId =
        ViewData["AnalyticsOrganisationId"]?.ToString();
    var organisationType =
        ViewData["AnalyticsOrganisationType"]?.ToString();

    var organisationCategory =
        ViewData["AnalyticsOrganisationCategory"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(connectionString))
{
    <script src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js"></script>
    <script src="https://js.monitor.azure.com/scripts/b/ext/ai.clck.2.min.js"></script>

    <script>
        (() => {
            const clickPlugin =
                new Microsoft.ApplicationInsights.ClickAnalyticsPlugin();

            const config = {
                connectionString: @Html.Raw(JsonSerializer.Serialize(connectionString)),
                enableAutoRouteTracking: false,
                extensions: [clickPlugin],
                extensionConfig: {
                    [clickPlugin.identifier]: {
                        autoCapture: true,
                        dataTags: {
                            useDefaultContentNameOrId: true
                        }
                    }
                }
            };

            const appInsights =
                new Microsoft.ApplicationInsights.ApplicationInsights({
                    config
                });

            appInsights.loadAppInsights();


            const organisationType =
                @Html.Raw(JsonSerializer.Serialize(organisationType));

            const organisationCategory =
                @Html.Raw(JsonSerializer.Serialize(organisationCategory));

            appInsights.addTelemetryInitializer(envelope => {
                if (!envelope.baseData) {
                    envelope.baseData = {};
                }

                if (!envelope.baseData.properties) {
                    envelope.baseData.properties = {};
                }

                Object.assign(envelope.baseData.properties, {
                    organisationType,
                    organisationCategory
                });
            });

            const userId = @Html.Raw(JsonSerializer.Serialize(analyticsUserId));
            const organisationId = @Html.Raw(JsonSerializer.Serialize(organisationId));

            if (userId && organisationId) {
                appInsights.setAuthenticatedUserContext(
                    userId,
                    organisationId,
                    false
                );
            }

            appInsights.trackPageView({
                name: document.title,
                uri: window.location.href
            });
            
            window.appInsights = appInsights;
        })();
    </script>
}

