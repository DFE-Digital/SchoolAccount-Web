@using SchoolAccount.Web.Mvc.Features.Header
@inject IHeaderContentProvider HeaderContentProvider

@* ReSharper disable Razor.LayoutNotResolved *@
@* ReSharper disable Razor.SectionNotResolved *@

@{
    Layout = "_GovUkPageTemplate";
}

@section Head {
    <link rel="stylesheet" href="~/app.css" asp-append-version="true"/>
}

@section GovUkHeader {
    <header class="simple-gov-header" data-module="govuk-header">
        <div class="govuk-header__container govuk-width-container">
            <div class="govuk-header__logo">
                <a href="#" class="govuk-header__link govuk-header__link--homepage">
                    <img src="~/assets/images/department-for-education_white.png"
                         alt="Department for Education"
                         class="govuk-header__logotype">
                </a>
            </div>
            <div class="header-navigation">
                @if (HeaderContentProvider.IsAuthenticated)
                {
                    <span class="header-navigation__school">@HeaderContentProvider.OrganisationName</span>

                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                    {
                        <button type="submit" class="header-navigation__link">
                            Sign out
                        </button>
                    }
                }
            </div>
        </div>
    </header>
}

@section GovUkServiceNavigation {
    <govuk-service-navigation service-name="School Account" service-url="/">
        <govuk-service-navigation-nav>
        </govuk-service-navigation-nav>
    </govuk-service-navigation>
}

@RenderBody()

@section GovUkFooter {
    <govuk-footer>
        <govuk-footer-meta>
            <govuk-footer-meta-items>
                <govuk-footer-meta-item href="#">Cookie Policy</govuk-footer-meta-item>
            </govuk-footer-meta-items>
        </govuk-footer-meta>
        <govuk-footer-content-licence/>
        <govuk-footer-copyright/>
    </govuk-footer>
}