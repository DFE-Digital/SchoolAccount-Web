@{
    var errors = TempData["ErrorSummary"] as IDictionary<string, string> ?? new Dictionary<string, string>();
}

@if (errors.Count > 0)
{
    <govuk-error-summary>
        @foreach (var (fieldId, message) in errors)
        {
            <govuk-error-summary-item href="#@fieldId">@message</govuk-error-summary-item>
        }
    </govuk-error-summary>
}
