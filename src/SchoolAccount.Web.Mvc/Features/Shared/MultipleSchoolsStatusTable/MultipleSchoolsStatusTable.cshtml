@model SchoolAccount.Web.Mvc.Features.Shared.MultipleSchoolsStatusTable.MultipleSchoolsStatusTableViewModel
@using SchoolAccount.Web.Mvc.Infrastructure

<div>
    <table class="govuk-table" data-module="moj-sortable-table">
        <caption class="govuk-table__caption govuk-table__caption--m">@Model.Title</caption>
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header" aria-sort="none">Name</th>
            <th scope="col" class="govuk-table__header" aria-sort="descending" >Status</th>
            <feature name="@FeatureFlags.MultiSchoolsStatusTableErrorsAndQueries">
                <th scope="col" class="govuk-table__header" aria-sort="none">Last Changed</th>
                <th scope="col" class="govuk-table__header" aria-sort="none">Errors</th>
                <th scope="col" class="govuk-table__header" aria-sort="none">Queries</th>
            </feature>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        @foreach (var schoolStatus in Model.SchoolStatuses)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@schoolStatus.Name</td>
                <td class="govuk-table__cell">@schoolStatus.Status</td>
                <feature name="@FeatureFlags.MultiSchoolsStatusTableErrorsAndQueries">
                    <td class="govuk-table__cell">@schoolStatus.UpdatedAt</td>
                    <td class="govuk-table__cell">@schoolStatus.Errors</td>
                    <td class="govuk-table__cell">@schoolStatus.Queries</td>
                </feature>
            </tr>
        }
        </tbody>
    </table>
</div>
