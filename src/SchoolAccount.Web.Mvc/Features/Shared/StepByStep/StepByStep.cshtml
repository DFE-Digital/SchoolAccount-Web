@model IReadOnlyList<SchoolAccount.Application.Features.GetCensusJourney.StepByStep>

<div data-module="appstepnav"
     class="app-step-nav js-hidden app-step-nav--large app-step-nav--tags" data-show-text="Show" data-hide-text="Hide"
     data-show-all-text="Show all steps" data-hide-all-text="Hide all steps">

  <ol class="app-step-nav__steps">

    @for (var position = 1; position <= Model.Count; position++)
    {
      var step = Model[position - 1];

      <li class="app-step-nav__step js-step">

        @* Title *@
        <div class="app-step-nav__header js-toggle-panel">
          <h2 class="app-step-nav__title">
            <span class="app-step-nav__circle app-step-nav__circle--number">
              <span class="app-step-nav__circle-inner">
                <span class="app-step-nav__circle-background">
                  <span class="govuk-visually-hidden govuk-!-display-none-print">Step</span> @position
                  <span class="govuk-visually-hidden govuk-!-display-none-print" aria-hidden="true">:</span>
                </span>
              </span>
            </span>
            @if (step.Status is not null)
            {
              <strong class="govuk-tag @(step.Status.Colour ?? "govuk-tag--grey") status-tag govuk-tag--wide">
                @step.Status.Label
              </strong>
            }
            <span class="js-step-title">@step.Title</span>
          </h2>
        </div>

        @* Content, supplied as HTML by the API *@
        <div class="app-step-nav__panel js-panel" id="step-by-step-panel-@position">
          @Html.Raw(step.Body)
        </div>

      </li>
    }

  </ol>

</div>

<script type="text/javascript" src="~/lib/step-by-step/step-by-step.navigation.js" asp-append-version="true"></script>
<script type="text/javascript">
  function initialiseStepByStep() {
    document.querySelectorAll('[data-module="appstepnav"]').forEach(function (element) {
      new GOVUK.Modules.AppStepNav(element).init();
    });
  }

  (function () {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialiseStepByStep);
    } else {
      initialiseStepByStep();
    }
  })();
</script>
