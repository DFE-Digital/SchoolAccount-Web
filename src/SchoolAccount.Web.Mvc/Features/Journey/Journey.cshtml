@model SchoolAccount.Web.Mvc.Features.Journey.JourneyViewModel
@{
    ViewData["Title"] = "Journey";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-xl census-title">@Model.Caption</span>
        <h1 class="govuk-heading-l">@Model.Title</h1>

        @if (!Model.IsMatOrLocalAuthority)
        {
            <strong
                class="govuk-tag govuk-tag--grey status-tag govuk-!-margin-bottom-6 govuk-tag--wide">@Model.Status</strong>
        }

        @if (Model.DisplayOverview)
        {
            <h2 class="govuk-heading-m">Overview</h2>
            <p class="govuk-body">@Model.Overview</p>
        }

        @if (Model.IsMatOrLocalAuthority)
        {
            <partial name="~/Features/Shared/MultipleSchoolsStatusTable/MultipleSchoolsStatusTable.cshtml"
                     model="@Model.MatSchoolsStatuses"/>
        }

        @if (Model.TryGetSteps(out var steps))
        {
            <h2 class="govuk-heading-m">Step by step</h2>
            <partial name="~/Features/Shared/StepByStep/StepByStep.cshtml" model="@steps"/>
        }

        <govuk-button-link
            href="@Model.CallToAction.Url"
            rel="noreferrer noopener"
            target="_blank">
            @Model.CallToAction.Label
            <span class="govuk-visually-hidden"> opens in new tab</span>
        </govuk-button-link>
    </div>

    <div class="govuk-grid-column-one-third">
        @if (Model.DisplayImportantDates)
        {
            <h2 class="govuk-heading-m">Important dates</h2>
            <govuk-summary-list class="govuk-!-margin-bottom-9">
                @foreach (var date in Model.ImportantDates)
                {
                    <row>
                        <key>@date.Label</key>
                        <value>@date.FormattedDate</value>
                    </row>
                }
            </govuk-summary-list>
        }

        @if (Model.DisplayUnderstandStatuses)
        {
            <h2 class="govuk-heading-m">About your status</h2>
            <p class="govuk-body">Statuses are updated overnight. You will be emailed when the status changes.</p>
            <govuk-details>
                <govuk-details-summary>
                    What your status means
                </govuk-details-summary>
                <govuk-details-text>
                    <ul class="govuk-list govuk-list--bullet govuk-list--spaced">
                        @foreach (var status in Model.UnderstandStatuses)
                        {
                            <li><strong>@status.Name</strong>: @status.Description</li>
                        }
                    </ul>
                </govuk-details-text>
            </govuk-details>
        }
        <div class="feedback-banner govuk-!-margin-top-0 govuk-!-margin-bottom-6">
            <h2 class="govuk-heading-m">@Model.SupportService.Title</h2>
            <p class="govuk-body">
                <a
                    href="@Model.SupportService.Url"
                    class="govuk-link govuk-link--no-visited-state"
                    rel="noreferrer noopener"
                    target="_blank"
                >
                    @Model.SupportService.Description</a
                >
                for queries and help.
            </p>
        </div>
    </div>
</div>