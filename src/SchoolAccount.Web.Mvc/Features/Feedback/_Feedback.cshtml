@model SchoolAccount.Web.Mvc.Features.Feedback.FeedbackViewModel
@{
    var feedbackErrors = TempData["FeedbackErrors"] as string[] ?? [];
    var messageError = feedbackErrors.FirstOrDefault();
}

<section id="page-feedback" class="footer-feedback" aria-label="Page feedback">
    <div class="govuk-width-container">
        @if (TempData["FeedbackSubmitted"] is null)
        {
            <div id="feedback-initial" class="footer-feedback__row footer-feedback__hidden" aria-hidden="true">
                <h2 class="govuk-heading-s govuk-!-margin-bottom-0">
                    Give feedback on this page or report a problem
                </h2>
                <button type="button" id="open-feedback" class="govuk-button footer-feedback__primary"
                        aria-expanded="false" aria-controls="tell-us-form">
                    Give feedback
                </button>
            </div>

            <div id="feedback-form" class="footer-feedback__row footer-feedback__row--submitted" aria-hidden="false"
                 data-has-errors="@(feedbackErrors.Length > 0 ? "true" : "false")">
                <form id="tell-us-form" asp-controller="Feedback" asp-action="Submit" 
                      method="post" novalidate>
                    @if (feedbackErrors.Length > 0)
                    {
                        <div class="govuk-error-summary" data-module="govuk-error-summary">
                            <div role="alert">
                                <h2 class="govuk-error-summary__title">There is a problem</h2>
                                <div class="govuk-error-summary__body">
                                    <ul class="govuk-list govuk-error-summary__list">
                                        @foreach (var error in feedbackErrors)
                                        {
                                            <li><a href="#feedbackMessage">@error</a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    <input type="hidden" name="returnUrl"
                           value="@($"{Context.Request.Path}{Context.Request.QueryString}")"/>
                    <div class="govuk-form-group @(messageError is not null ? "govuk-form-group--error" : null)">
                        <h2 class="govuk-label-wrapper">
                            <label class="govuk-label govuk-label--m" for="feedbackMessage">
                                Your feedback
                            </label>
                        </h2>
                        <div id="what-do-you-want-to-tell-us-hint" class="govuk-hint">
                            Tell us what you think or describe the problem
                        </div>
                        @if (messageError is not null)
                        {
                            <p id="feedbackMessage-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @messageError
                            </p>
                        }
                        <textarea class="govuk-textarea @(messageError is not null ? "govuk-textarea--error" : null)"
                                  id="feedbackMessage" name="feedbackMessage" rows="5"
                                  aria-describedby="what-do-you-want-to-tell-us-hint @(messageError is not null ? "feedbackMessage-error" : null)"></textarea>
                    </div>
                    <div class="govuk-button-group">
                        <button type="submit" class="govuk-button footer-feedback__send">
                            Send feedback
                        </button>
                        <button id="cancel-feedback" type="button" class="govuk-button govuk-button--secondary footer-feedback__cancel footer-feedback__hidden" aria-hidden="true">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="footer-feedback__row footer-feedback__row--submitted">
                <h2 id="feedback-thanks" class="govuk-heading-s govuk-!-margin-bottom-0">
                    Thank you for your feedback
                </h2>
            </div>
        }
    </div>
</section>

<script type="text/javascript" src="~/lib/feedback/feedback.js" asp-append-version="true"></script>