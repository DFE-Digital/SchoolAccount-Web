@model SchoolAccount.Web.Mvc.Features.Start.StartViewModel
@{
    ViewData["Title"] = "Home Page";
}

<h1 class="govuk-heading-l">@Model.GreetingMessage</h1>

<p class="govuk-body">
    Login with a DSI Account to access your School Account.
</p>

<a asp-controller="Account" asp-action="SignIn" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
    Sign in
</a>