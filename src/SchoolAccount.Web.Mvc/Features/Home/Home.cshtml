@model SchoolAccount.Web.Mvc.Features.Home.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<h1 class="govuk-heading-l">@Model.GreetingMessage</h1>

<p class="govuk-body">
    Login with a DSI Account to access your School Account.
</p>

<a asp-controller="Login" asp-action="Login" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
    Sign in
</a>