@model SchoolAccount.Web.Mvc.Features.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="govuk-heading-l">@Model.GreetingsMessage @Model.User</h1>
<p class="govuk-body">
    This is an authenticated page.
</p>

<div class="govuk-button-group">
    <a href="https://www.gov.uk/guidance/complete-the-school-census/generate-and-submit-your-return"
       role="button"
       rel="noreferrer noopener"
       draggable="false"
       class="govuk-button"
       data-module="govuk-button">
        Go to Autumn Census 2026
        <span class="govuk-visually-hidden"> opens in new tab</span>
    </a>
</div>
