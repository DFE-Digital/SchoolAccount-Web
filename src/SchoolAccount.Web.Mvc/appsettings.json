{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console"
      }
    }
  },
  "AllowedHosts": "*",
  "AzureAppConfiguration": {
    "Enabled": true
  },
  "OpenIDConnectSettings": {
    "Authority": "",
    "ClientId": ""
  },
  "DataProtectionSettings": {
    "KeyRingBlobUri": "",
    "KeyEncryptionKeyUri": ""
  },
  "ForwardedHeadersSettings": {
    "TrustAllNetworks": true,
    "TrustedNetworks": []
  },
  "CommonApiSettings": {
    "CollectApiUrl": ""
  },
  "AcademiesApiClient": {
    "BaseUrl": "",
    "ApiKey": ""
  },
  "Telemetry": {
    "Destination": "AzureMonitor"
  }
}
